# Copy to .env and fill in values

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
GITHUB_TOKEN_ENC_KEY=
GITHUB_WEBHOOK_SECRET=

# Public HTTPS origin of this API (no trailing slash). Used for GitHub webhooks, e.g. ngrok:
WEBHOOK_PUBLIC_URL=

# OpenAI (optional — incidents still open without it; AI status will be skipped_no_api_key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

FRONTEND_URL=http://localhost:3000
# Optional: comma-separated extra origins for CORS (e.g. preview deploys)
# CORS_EXTRA_ORIGINS=

FIREBASE_PROJECT_ID=
# Local file path to service account JSON:
FIREBASE_SERVICE_ACCOUNT_KEY=
# Or (recommended for Railway): paste minified JSON in one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
